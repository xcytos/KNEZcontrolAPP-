{
  "identifier": "default",
  "description": "Default capabilities for KNEZ Control App",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-applocaldata-write",
    "fs:allow-read",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/.config/opencode/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/.config/opencode/**" }]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$HOME/.config/opencode/**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$HOME/.config/opencode/**" }]
    },
    "http:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:allow-open",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "start-local-stack",
          "cmd": "powershell.exe",
          "args": [
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "scripts/start_local_stack.ps1"
          ]
        },
        {
          "name": "taqwin-mcp",
          "cmd": "powershell.exe",
          "args": [
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "scripts/start_taqwin_mcp.ps1"
