          "args": [
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "scripts/verify-delivery.ps1"
          ]
        },
        {
          "name": "powershell",
          "cmd": "powershell.exe",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd.exe",
          "args": true
